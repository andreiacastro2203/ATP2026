import random

def menu():
    print("Menu")
    print("(0) Sair")
    print("(1) Criar Lista")
    print("(2) Ler Lista")
    print("(3) Soma")
    print("(4) Média")
    print("(5) Maior")
    print("(6) Menor")
    print("(7) estaOrdenada por ordem crescente")
    print("(8) estaOrdenada por ordem decrescente")
    print("(9) Procura um elemento")

def criarLista():
    lista = []
    comp = random.randint(1, 10)
    while comp > 0:
        n = random.randint(1, 100)
        lista.append(n)
        comp = comp - 1
    return lista

def lerLista ():
    lista = []
    continuar = "s"
    while continuar == "s":
        n = int(input("Introduza um número inteiro"))
        lista.append(n)
        continuar = int(input("Deseja adicionar mais algum número à sua liasta? (s/n)"))
    return lista

def soma (lista):
    i = 0
    soma = 0
    while i < len(lista):
        soma = soma + lista[i]
        i = i + 1
    return soma

def media (lista):
    i = 0
    soma = 0
    while i < len(lista):
        soma = soma + lista[i]
        i = i + 1
    media = soma/len(lista)
    return media

def maior(lista):
    i = 1
    maior = lista[0]
    while i < len(lista):
        if lista[i] > maior:
            maior = lista[i]
        i = i + 1
    return maior

def menor(lista):
    i = 0
    menor = lista[i]
    while i < len(lista):
        if lista[i] < menor:
            menor = lista[i]
        i = i + 1
    return menor

def ordenaCrescente(lista):
    i = 0
    while i < len(lista) - 1 and lista[i] <= lista[i + 1]:
        i = i + 1
    return i >= len(lista) - 1

def ordenaDecrescente(lista):
    i = 0
    while i < len(lista) - 1 and lista[i] >= lista[i + 1]:
        i = i + 1
    return i >= len(lista) - 1

def procuraElemento(lista, elem):
    i = 0
    res = -1
    while i < len(lista) and elem != lista[i]:
        i = i + 1
    if i < len(lista):
        res = i
    return res
 
def simNao(valor):
    if valor:
        return "Sim"
    return "Não"

def main():
    listaatual = []
    op = -1
    while op != 0:
        menu()
        try:
            op = int(input("Escolha uma opção: "))
        except ValueError:
            print("Opção inválida. Introduza um número de 0 a 9.")
            op = -1
            continue

        if op == 1:
            listaatual = criarLista()
            print(f"Lista criada com sucesso: {listaatual}")

        elif op == 2:
            listaatual = lerLista()
            print(f"Lista lida com sucesso: {listaatual}")

        elif op == 3:
            print(f"Soma dos elementos: {soma(listaatual)}")

        elif op == 4:
            print(f"Média dos elementos: {media(listaatual)}")

        elif op == 5:
            print(f"Maior elemento: {maior(listaatual)}")

        elif op == 6:
            print(f"Menor elemento: {menor(listaatual)}")

        elif op == 7:
            print(f"Está ordenada por ordem crescente? {simNao(ordenaCrescente(listaatual))}")

        elif op == 8:
            print(f"Está ordenada por ordem decrescente? {simNao(ordenaDecrescente(listaatual))}")

        elif op == 9:
            elem = int(input("Qual o elemento que pretende procurar? "))
            print(f"Posição do elemento (-1 se não existir): {procuraElemento(listaatual, elem)}")

        elif op == 0:
            print("A terminar o programa. Até breve!")
            print(f"Lista guardada neste momento: {listaatual}")

        elif 3 <= op <= 9 and len(listaatual) == 0:
            print("A lista está vazia. Crie ou leia uma lista primeiro (opção 1 ou 2).")

        else:
            print("Opção inválida. Introduza um número de 0 a 9.")

main()