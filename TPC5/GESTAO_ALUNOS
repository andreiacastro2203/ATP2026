def Criarturma(turma):
    turma = []
    n = int(input("Quantos alunos tem a turma?"))
    
    for i in range(n):
        print(f"\nAluno {i + 1}:")
        nome = input("Nome: ")
        id_aluno = input("ID: ")
        notaTPC = float(input("Nota do TPC: "))
        notaProj = float(input("Nota do Projeto: "))
        notaTeste = float(input("Nota do Teste: "))
        
        aluno = (nome, id_aluno, [notaTPC, notaProj, notaTeste])
        turma.append(aluno)
    
    return turma

